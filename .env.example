# Google Gemini API key (server-side only — never expose to the browser)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Secret used to sign session cookies. Use a long random string.
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Node environment
NODE_ENV="development"

# Public base URL used by server components when calling internal API routes
APP_URL="http://localhost:3000"

# Model name used for AI generation (optional, defaults to gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# Firebase Admin credentials (server-side only — never expose to the browser).
# Create a service account in the Firebase console (Project settings > Service
# accounts > Generate new private key), then fill in:
# - FIREBASE_PROJECT_ID: the Firebase project id
# - FIREBASE_CLIENT_EMAIL: the service account email
# - FIREBASE_PRIVATE_KEY: the PEM private key. Keep the literal \n escapes.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-example@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Seed the exercise & achievement reference data into Firestore:
#   npm run seed